+# Gateway. Diese Variable wird an alle Unterprozesse vererbt: HardwareConfig.py
+# und Laserpointer/main.py posten dann an den Gateway statt direkt auf den
+# seriellen Port. (Voraussetzung: combined_firmware.ino ist geflasht.)
+os.environ.setdefault("ARDUINO_GATEWAY_URL", "http://127.0.0.1:8005")
+
 services = [
+    # Gateway zuerst: einziger Besitzer des seriellen Ports, kein --reload
+    # (sonst würde der Port doppelt geöffnet).
+    (ROOT / "ArduinoGateway", [sys.executable, "-m", "uvicorn", "gateway:app","--host", "0.0.0.0", "--port", "8005"]),
     (ROOT / "visual", [sys.executable, "server.py"]),
